SNULL(d.CantidadDetalles, 0) = 0 AND d.Id_Venta IS NOT NULL THEN 1 ELSE 0 END AS HabilitarCargarMaterial,        ISNULL(d.TieneDetalle, 0) AS TieneDetalle FROM Solicitud s LEFT JOIN Detalles d ON d.OrdenTrabajo = s.OrdenTrabajo AND d.CodigoCliente = s.CodigoCliente LEFT JOIN dbo.tbl_estado e ON e.Id_Estado = d.Id_Estado AND ISNULL(e.E_Eliminado, 0) = 0]
